{{ $commit := .Theme.LatestCommit }}
{{ if .Commit }}
    {{ $commit = .Commit }}
{{ end }}

<section>
    <h1>{{ .Theme.Name }}</h1>
    <div class="authors">
        <code>{{ .Theme.ID }}</code> v{{ $commit.Version }}
        by
        {{ range $index, $admin := .Theme.Admins }}
            {{ if $index }}, {{ end }}
            <a href="/user/{{ $admin }}">{{ $admin }}</a>
        {{ end }}
        -
        {{ if .Commit }}
            <a href="/theme/{{ .Theme.ID }}/commit/{{ $commit.Version }}.css">Raw CSS without autoupdate</a>
            <a href="/theme/{{ .Theme.ID }}">Latest version</a>
            <a href="/theme/{{ .Theme.ID }}/commits">Version history</a>
        {{ else }}
            <a href="/theme/{{ .Theme.ID }}.css">Raw CSS</a>
            (or <a href="/theme/{{ .Theme.ID }}/commit/{{ $commit.Version }}.css">without autoupdate</a>)
            <a href="/theme/{{ .Theme.ID }}/commits">Version history</a>
            <a href="/theme/{{ .Theme.ID }}/edit">Edit theme</a>
        {{ end }}
        {{ if .User }}
            <a href="/theme/{{ .Theme.ID }}/report">Report theme</a>
        {{ end }}
    </div>
    {{ if not .Commit }}
        <div class="last-updated small-text">
            Last updated {{ timeformat $commit.CreatedAt }}
        </div>
    {{ end }}
</section>

{{ if .Commit }}
    <section>
        <h3>Commit info</h3>
        <div class="last-updated">
            Committed {{ timeformat $commit.CreatedAt }} by <a href="/user/{{ $commit.CreatedBy }}">{{ $commit.CreatedBy }}</a>
        </div>
        <blockquote class="commit-message">
            {{ .Commit.Message }}
        </blockquote>
    </section>
{{ end }}
<section class="theme-likes">
    <span>{{ .Theme.Likes }} {{ if eq .Theme.Likes 1 }}like{{ else }}likes{{ end }}</span>
    {{ if .User }}
        <form action="/theme/{{ .Theme.ID }}/like" method="post">
            <button type="submit" name="action" value="{{ if .Liked }}unlike{{ else }}like{{ end }}">{{ if .Liked }}Unlike{{ else }}Like{{ end }}</button>
        </form>
    {{ end }}
</section>
<section>
    <h3>Description</h3>
    <p class="theme-description">
        {{ $commit.Description }}
    </p>
</section>

<section>
    <h3>Previews</h3>
    {{ range $index, $img := $commit.Previews }}
        <a href="/image/{{ $img }}" target="_blank">
            <img class="preview-image" src="/image/{{ $img }}" alt="Preview image #{{ add $index 1 }}" />
        </a>
    {{ end }}
    {{ if not $commit.Previews }}
        <p>None 😿</p>
    {{ end }}
</section>

<section>
    <h3>Code</h3>
    <p>
        To use this theme, paste this into your custom CSS:
    </p>
    <pre><code class="language-css">@import url("https://css.gomuks.app/theme/{{ .Theme.ID }}.css");</code></pre>
    <details>
        <summary>Full CSS</summary>
        <pre><code class="language-css">{{ $commit.Content }}</code></pre>
    </details>
</section>

<section class="comments" id="comments">
    <h3>Comments</h3>
    {{ if .User }}
        <form class="comment-form" action="/theme/{{ .Theme.ID }}/comments" method="post">
            <label for="comment-text">Add a comment</label>
            <textarea id="comment-text" name="text" rows="3" maxlength="8192" required></textarea>
            <button type="submit">Comment</button>
        </form>
    {{ end }}
    {{ range .CommentThreads }}
        {{ template "comment" . }}
    {{ else }}
        <p>No comments yet.</p>
    {{ end }}
</section>
